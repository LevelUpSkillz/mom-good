# PostgreSQL database used for persistent catalog and order data.
DATABASE_URL=

# Private Mom Good admin credentials. Keep both server-only.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Server-only Printful credentials. Never expose these to the browser.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=

# Stripe checkout. Keep secret values server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SHIPPING_RATE_ID=
STRIPE_AUTOMATIC_TAX=false

# Safety switches. Checkout and automatic fulfillment remain OFF unless explicitly enabled.
CHECKOUT_ENABLED=false
PRINTFUL_AUTO_SUBMIT=false

# Public storefront origin used for metadata and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
