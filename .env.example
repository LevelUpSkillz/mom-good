# PostgreSQL database used for persistent catalog and order data.
DATABASE_URL=

# Private Mom Good admin credentials. Keep both server-only.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Server-only Printful credentials. Never expose these to the browser.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=

# Public storefront origin used for metadata and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
